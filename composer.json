{
  "name": "vanqard/common",
  "description": "Common classes for PHP 8+",
  "homepage": "https://github.com/vanqard/common",
  "license": "MIT",
  "authors": [
    {
      "name": "Thunder Raven-Stoker",
      "email": "thunder@vanqard.com",
      "homepage": "https://phpbrilliance.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Vanqard\\Common\\": "Common"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vanqard\\Common\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^10.0",
    "bugsnag/bugsnag": "^3.0",
    "sentry/sentry": "^4.0"
  },
  "suggest": {
    "bugsnag/bugsnag": "Required to use Vanqard\\Common\\Trackers\\Adapters\\BugsnagAdapter",
    "sentry/sentry": "Required to use Vanqard\\Common\\Trackers\\Adapters\\SentryAdapter"
  }
}
